// The .dov prelude: loaded before every program. Its enums may be written
// without the `Enum::` prefix (`Some(x)`, `None`, `Ok(v)`, `Err(e)`).

enum Option<T> {
    Some(T),
    None,
}

enum Result<T, E> {
    Ok(T),
    Err(E),
}

fn is_some<T>(o: Option<T>) -> bool {
    match o {
        Some(_) => {
            return true;
        }
        None => {
            return false;
        }
    }
}

fn is_none<T>(o: Option<T>) -> bool {
    return !is_some(o);
}

fn unwrap<T>(o: Option<T>) -> T {
    match o {
        Some(v) => {
            return v;
        }
        None => {
            panic("called `unwrap` on `None`");
        }
    }
}

fn unwrap_or<T>(o: Option<T>, fallback: T) -> T {
    match o {
        Some(v) => {
            return v;
        }
        None => {
            return fallback;
        }
    }
}

fn is_ok<T, E>(r: Result<T, E>) -> bool {
    match r {
        Ok(_) => {
            return true;
        }
        Err(_) => {
            return false;
        }
    }
}

fn is_err<T, E>(r: Result<T, E>) -> bool {
    return !is_ok(r);
}

fn unwrap_ok<T, E>(r: Result<T, E>) -> T {
    match r {
        Ok(v) => {
            return v;
        }
        Err(_) => {
            panic("called `unwrap_ok` on `Err`");
        }
    }
}

fn unwrap_err<T, E>(r: Result<T, E>) -> E {
    match r {
        Ok(_) => {
            panic("called `unwrap_err` on `Ok`");
        }
        Err(e) => {
            return e;
        }
    }
}

fn ok_or<T, E>(o: Option<T>, e: E) -> Result<T, E> {
    match o {
        Some(v) => {
            return Ok(v);
        }
        None => {
            return Err(e);
        }
    }
}
