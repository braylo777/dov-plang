enum Shape {
    Circle(i64),
    Rect(i64, i64),
    Dot
}

fn area(s: Shape) -> i64 {
    match s {
        Shape::Circle(r) => {
            return 3 * r * r;
        }
        Shape::Rect(w, h) => {
            return w * h;
        }
        Shape::Dot => {
            return 0;
        }
    }
}

fn main() {
    print(area(Shape::Circle(2)), " ", area(Shape::Rect(3, 4)), " ", area(Shape::Dot));
}
