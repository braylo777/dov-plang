struct User {
    name: str,
    age: i64
}

fn find(us: [User], name: str) -> Option<User> {
    var i = 0;
    while i < len(us) {
        if us[i].name == name {
            return Some(us[i]);
        }
        i = i + 1;
    }
    return None;
}

fn main() {
    let us = [User { name: "a", age: 1 }, User { name: "b", age: 2 }];
    print(unwrap(find(us, "b")).age, " ", is_none(find(us, "z")));
}
