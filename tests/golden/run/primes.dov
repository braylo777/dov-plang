fn is_prime(n: i64) -> bool {
    if n < 2 {
        return false;
    }
    var d = 2;
    while d * d <= n {
        if n % d == 0 {
            return false;
        }
        d = d + 1;
    }
    return true;
}

fn main() {
    var n = 0;
    var found = 0;
    while found < 10 {
        if is_prime(n) {
            print(n);
            found = found + 1;
        }
        n = n + 1;
    }
}
