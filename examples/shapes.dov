// Structs and enums: value types, field updates through `var`, exhaustive `match`.
struct Point {
    x: i64,
    y: i64
}

enum Shape {
    Circle(Point, i64),
    Rect(Point, Point),
    Segment(Point, Point)
}

fn area(s: Shape) -> i64 {
    match s {
        Shape::Circle(_, r) => {
            return 314 * r * r / 100;
        }
        Shape::Rect(a, b) => {
            return (b.x - a.x) * (b.y - a.y);
        }
        Shape::Segment(_, _) => {
            return 0;
        }
    }
}

fn name(s: Shape) -> str {
    match s {
        Shape::Circle(_, _) => {
            return "circle";
        }
        Shape::Rect(_, _) => {
            return "rect";
        }
        Shape::Segment(_, _) => {
            return "segment";
        }
    }
}

fn main() {
    var corner = Point { x: 0, y: 0 };
    let shapes = [Shape::Circle(corner, 10), Shape::Rect(corner, Point { x: 4, y: 5 }), Shape::Segment(corner, Point { x: 1, y: 1 })];
    corner.x = 99; // a copy: the shapes above keep x = 0
    var total = 0;
    var i = 0;
    while i < len(shapes) {
        print(name(shapes[i]), ": ", area(shapes[i]));
        total = total + area(shapes[i]);
        i = i + 1;
    }
    print("total area: ", total, ", corner.x = ", corner.x);
}
