fn steps(start: i64) -> i64 {
    var n = start;
    var s = 0;
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        s = s + 1;
    }
    return s;
}

fn main() {
    var best = 0;
    var arg = 0;
    var i = 1;
    while i < 500000 {
        let s = steps(i);
        if s > best {
            best = s;
            arg = i;
        }
        i = i + 1;
    }
    print(arg, " ", best);
}
