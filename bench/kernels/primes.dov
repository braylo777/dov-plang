fn is_prime(n: i64) -> bool {
    if n < 2 {
        return false;
    }
    var d = 2;
    while d * d <= n {
        if n % d == 0 {
            return false;
        }
        d = d + 1;
    }
    return true;
}

fn main() {
    var count = 0;
    var n = 0;
    while n < 300000 {
        if is_prime(n) {
            count = count + 1;
        }
        n = n + 1;
    }
    print(count);
}
