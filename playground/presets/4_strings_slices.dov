// Strings and slices are immutable; append and concat build new values.
fn reverse(s: str) -> str {
    var out = "";
    var i = len(s) - 1;
    while i >= 0 {
        out = concat(out, s[i..i + 1]);
        i = i - 1;
    }
    return out;
}

fn main() {
    let a = [1, 2];
    let b = append(a, 3);
    print(len(a), " ", len(b), " ", b[2]);
    print(reverse("stressed"));
}
