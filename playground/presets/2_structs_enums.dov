// Structs are value types; enums are tagged unions; match is exhaustive.
struct Point {
    x: i64,
    y: i64
}

enum Shape {
    Circle(Point, i64),
    Rect(Point, Point)
}

fn area(s: Shape) -> i64 {
    match s {
        Shape::Circle(_, r) => {
            return 3 * r * r;
        }
        Shape::Rect(a, b) => {
            return (b.x - a.x) * (b.y - a.y);
        }
    }
}

fn main() {
    var p = Point { x: 0, y: 0 };
    p.x = 2;
    print(area(Shape::Circle(p, 2)), " ", area(Shape::Rect(Point { x: 0, y: 0 }, Point { x: 3, y: 4 })));
}
